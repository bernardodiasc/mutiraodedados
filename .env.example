# Configuração de exemplo. Copie para `.env` e preencha com os valores do
# seu projeto Lovable Cloud / Supabase.
#
# Onde encontrar:
# - Lovable: abra o projeto → Cloud → Settings → API
# - Supabase direto: Project Settings → API

VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-publica"

# Espelhos server-side (mesmos valores, sem o prefixo VITE_). Usados em SSR
# e em server functions do TanStack Start.
SUPABASE_URL="https://seu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-publica"

# Service role: NUNCA exponha no client. Usada apenas em server routes /
# server functions com privilégios administrativos.
# SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Chave da API do Portal da Transparência (https://api.portaldatransparencia.gov.br/swagger-ui.html)
# PORTAL_TRANSPARENCIA_API_KEY=""

# Lovable AI Gateway (opcional — só se você for usar o gateway gerenciado)
# LOVABLE_API_KEY=""